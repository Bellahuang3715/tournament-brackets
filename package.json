{
  "name": "tournament-brackets-ui",
  "version": "0.1.16",
  "description": "A React component library for rendering tournament brackets.",
  "author": "Bella Huang",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "require": "./dist/index.cjs"
    },
    "./style.css": "./dist/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
